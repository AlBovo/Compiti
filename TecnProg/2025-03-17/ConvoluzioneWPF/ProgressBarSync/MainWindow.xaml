<Window x:Class="ProgressBarSync.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProgressBarSync"
        mc:Ignorable="d"
        Title="ProgressBarSync" Height="280" Width="480" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid>
        <Button Content="Start Progress Bar" HorizontalAlignment="Left" Margin="40,100,0,0" Height="34" Width="120" VerticalAlignment="Top" Click="StartProgressBar"/>
        <ProgressBar x:Name="progressBar1" HorizontalAlignment="Left" Height="24" Margin="260,30,0,0" VerticalAlignment="Top" Width="170"/>
        <TextBox x:Name="textBox1" HorizontalAlignment="Left" Margin="260,70,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="170" Height="24"/>
        <ProgressBar x:Name="progressBar2" HorizontalAlignment="Left" Height="24" Margin="260,130,0,0" VerticalAlignment="Top" Width="170"/>
        <TextBox x:Name="textBox2" HorizontalAlignment="Left" Margin="260,170,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="170" Height="24"/>
    </Grid>
</Window>
